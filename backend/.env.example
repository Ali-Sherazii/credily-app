PORT=5000
NODE_ENV=production
MONGODB_URI=your_mongodb_atlas_connection_string
JWT_SECRET=a_long_random_secret

# Comma-separated list of allowed frontend origins (your Vercel URL, plus any preview URLs)
FRONTEND_URL=https://your-app.vercel.app

# Cloudinary (cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Google Cloud sentiment analysis
# Requires backend/config/google-credentials.json to exist (e.g. via Render's "Secret Files").
# If omitted, the app falls back to mock sentiment analysis.
USE_REAL_SENTIMENT=false
